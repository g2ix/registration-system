# Copy this file to .env and fill in your values

# Path to the SQLite database file
DATABASE_URL="file:./dev.db"

# Must be a long random string — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# The address typed in the browser. Use http://localhost:3000 on this PC only.
# For phones and other computers on the same network, use http://<this-PC-IPv4>:3000
# and restart the server. See docs/running.md.
NEXTAUTH_URL="http://localhost:3000"
